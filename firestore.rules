rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    function isGoogle() { return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous'; }
    function me(t)      { return /databases/$(db)/documents/trips/$(t)/members/$(request.auth.uid); }
    function isMember(t){ return signedIn() && exists(me(t)); }
    function role(t)    { return get(me(t)).data.role; }
    function canEdit(t) { return isMember(t) && (role(t) == 'owner' || role(t) == 'editor'); }
    function isOwner(t) { return isMember(t) && role(t) == 'owner'; }

    // which trip this person (or guest) opens by default
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // share link: the link carries a random token. A signed-in person can look up ONE token they hold (no listing); only the owner creates or deletes tokens
    match /links/{token} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if isGoogle() && isOwner(request.resource.data.tid);
      allow delete: if isOwner(resource.data.tid);
    }

    match /trips/{t} {
      allow read: if isMember(t);
      allow create: if isGoogle() && request.resource.data.owner == request.auth.uid;
      allow update, delete: if isOwner(t);

      // the trip content: editors and the owner can write, viewers can only read
      match /data/{key} {
        allow read: if isMember(t);
        allow create, update, delete: if canEdit(t);
      }

      // the owner's own record of the active share link
      match /invites/{token} {
        allow read, write: if isOwner(t);
      }

      match /members/{uid} {
        allow read: if isOwner(t) || (signedIn() && request.auth.uid == uid && isMember(t));

        // 1) a signed-in Google user becomes owner of a brand-new trip
        allow create: if isGoogle() && request.auth.uid == uid
          && request.resource.data.role == 'owner'
          && !exists(/databases/$(db)/documents/trips/$(t))
          && getAfter(/databases/$(db)/documents/trips/$(t)).data.owner == request.auth.uid;

        // 2) anyone holding the trip's current share-link token can join as an editor
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.role == 'editor'
          && exists(/databases/$(db)/documents/links/$(request.resource.data.token))
          && get(/databases/$(db)/documents/links/$(request.resource.data.token)).data.tid == t;

        allow delete: if isOwner(t) || (signedIn() && request.auth.uid == uid);
      }
    }
  }
}
